{
  "expo": {
    "name": "Vahan360",
    "slug": "vahan360-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vahan360",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vahan360.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vahan360 uses your location to show nearby drivers, set your pickup point automatically, and give you accurate fare estimates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF7A00"
      },
      "package": "com.vahan360.customer",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vahan360 uses your location to show nearby drivers, set your pickup point automatically, and give you accurate fare estimates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B00",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}